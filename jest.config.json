{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "testMatch": [
    "**/test/**/*.spec.ts"
  ],
  "testTimeout": 30000,
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/main.ts",
    "!src/database.ts",
    "!src/app.module.ts"
  ],
  "coverageThreshold": {
    "global": {
      "branches": 70,
      "functions": 90,
      "lines": 90,
      "statements": 85
    }
  }
}
